# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillforge?schema=public"
# Optional pool tuning (defaults: 10 connections, 10000 ms idle timeout).
# With the local `prisma dev` server, DATABASE_POOL_MAX="1" was the most stable in testing.
DATABASE_POOL_MAX=""
DATABASE_IDLE_TIMEOUT_MS=""
# Only needed by `prisma migrate dev` when the DB user cannot create databases.
SHADOW_DATABASE_URL=""
# No local Postgres? `npx prisma dev -n skillforge -d` starts one and prints its
# TCP URLs (use the postgres:// URLs, not prisma+postgres://).

# ─── Auth.js ───────────────────────────────────────────────────────────────
# Required, min 32 chars. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Set to "true" when running behind a trusted host/proxy or `next start` locally.
# In production prefer AUTH_URL="https://your-domain".
AUTH_TRUST_HOST=""
# Sign-ups allowed per IP per hour (default 10). Rate limits are in-memory per instance.
AUTH_REGISTER_LIMIT_PER_HOUR=""
# Reverse proxies in front of the app that append to X-Forwarded-For (default 1:
# one load balancer / Vercel / nginx with $proxy_add_x_forwarded_for). The client IP
# used for rate limiting is taken from the entry added by the outermost trusted
# proxy; anything a client sends itself is ignored. 0 = never trust the header.
TRUSTED_PROXY_HOPS=""
# Google OAuth (optional). Leave empty to hide Google sign-in.
# Redirect URI: <app-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Email (password reset) ────────────────────────────────────────────────
# Not configured yet. In development, reset links are printed to the server log.
# MAIL_TRANSPORT="console" forces that outside development; it is refused in production
# (it would write reset links, which are secrets, to the logs).
MAIL_TRANSPORT=""

# ─── AI provider ───────────────────────────────────────────────────────────
# Server-only. The app depends on lib/ai's interface; getAIProvider() picks the
# implementation.
#   mock      – deterministic rule-based output for development/tests. Results are
#               labelled "mock" in the UI and are NOT AI analysis.
#   anthropic – Claude via the Anthropic API (requires AI_API_KEY).
AI_PROVIDER="mock"
AI_API_KEY=""
# Optional model override (anthropic default: claude-opus-5-5).
AI_MODEL=""
# Per-request timeout for AI calls, in milliseconds.
AI_TIMEOUT_MS="120000"

# ─── File storage ──────────────────────────────────────────────────────────
# Private CV storage. "local" writes to STORAGE_LOCAL_DIR (never under public/).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"

# ─── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB="10"
