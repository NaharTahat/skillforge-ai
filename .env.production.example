# SkillForge AI — production environment template (Railway).
# PLACEHOLDERS ONLY. Never put real values in this file or commit real values anywhere.
# Set real values as Railway service variables (Project → app service → Variables).
# The server refuses to start in production when a value is unsafe (see lib/env-schema.ts),
# and `npm run preflight` checks them before a release.
#
# Build-time note: NEXT_PUBLIC_APP_URL and AUTH_URL are read when the app is BUILT
# (canonical URLs, reset links, HSTS). After changing them, redeploy so it rebuilds.

NODE_ENV="production"

# ─── URLs (must be https; same origin) ──────────────────────────────────────
# Until a custom domain exists, use the Railway domain, e.g. https://<service>.up.railway.app
NEXT_PUBLIC_APP_URL="https://<your-app-domain>"
AUTH_URL="https://<your-app-domain>"
# Railway terminates TLS at its edge and forwards to the app.
AUTH_TRUST_HOST="true"

# ─── Client IP for rate limiting ────────────────────────────────────────────
# Railway's edge sets X-Real-IP to the client's address on every request.
CLIENT_IP_HEADER="x-real-ip"
# Only used with CLIENT_IP_HEADER="x-forwarded-for".
TRUSTED_PROXY_HOPS="1"

# ─── Auth ───────────────────────────────────────────────────────────────────
# 32+ random characters, unique to production: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET="<generate-a-new-random-secret>"
AUTH_REGISTER_LIMIT_PER_HOUR="10"
# Optional Google sign-in: set both or neither. Redirect URI: <app-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Database ───────────────────────────────────────────────────────────────
# Railway reference to the Postgres service (private network). Use a dedicated
# production database — never the development or E2E database.
DATABASE_URL="${{Postgres.DATABASE_URL}}"
# One instance with a pool of 10 stays well under PostgreSQL's default 100 connections.
DATABASE_POOL_MAX="10"

# ─── AI (Anthropic) ─────────────────────────────────────────────────────────
AI_PROVIDER="anthropic"
AI_API_KEY="<anthropic-api-key>"
# Optional model override (default: claude-opus-5-5).
AI_MODEL=""
AI_TIMEOUT_MS="120000"

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Requires a domain verified in Resend; without one, Resend only delivers to your own account address.
MAIL_TRANSPORT="resend"
RESEND_API_KEY="<resend-api-key>"
MAIL_FROM="SkillForge AI <no-reply@<your-verified-domain>>"

# ─── File storage (CVs) ─────────────────────────────────────────────────────
# Absolute path on the Railway volume (mount the volume at /data).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/data/uploads"
MAX_UPLOAD_SIZE_MB="10"
